<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee 
                             http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
         version="3.0"
         metadata-complete="true">
    
    <display-name>AI Resume Analyzer</display-name>

    <!-- Servlet Mapping -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.resumeanalyzer.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.resumeanalyzer.servlet.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>com.resumeanalyzer.servlet.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UploadServlet</servlet-name>
        <servlet-class>com.resumeanalyzer.servlet.UploadServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UploadServlet</servlet-name>
        <url-pattern>/upload</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ResultServlet</servlet-name>
        <servlet-class>com.resumeanalyzer.servlet.ResultServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ResultServlet</servlet-name>
        <url-pattern>/result</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.resumeanalyzer.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SettingsServlet</servlet-name>
        <servlet-class>com.resumeanalyzer.servlet.SettingsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SettingsServlet</servlet-name>
        <url-pattern>/settings</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AnalysesServlet</servlet-name>
        <servlet-class>com.resumeanalyzer.servlet.AnalysesServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AnalysesServlet</servlet-name>
        <url-pattern>/analyses</url-pattern>
    </servlet-mapping>

    <!-- Filters -->
    <filter>
        <filter-name>SessionFilter</filter-name>
        <filter-class>com.resumeanalyzer.servlet.SessionFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>SessionFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <servlet>
        <servlet-name>RoadmapServlet</servlet-name>
        <servlet-class>com.resumeanalyzer.servlet.RoadmapServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RoadmapServlet</servlet-name>
        <url-pattern>/roadmap</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>SaveRoadmapServlet</servlet-name>
        <servlet-class>com.resumeanalyzer.servlet.SaveRoadmapServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SaveRoadmapServlet</servlet-name>
        <url-pattern>/save-roadmap</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UpdateTaskProgressServlet</servlet-name>
        <servlet-class>com.resumeanalyzer.servlet.UpdateTaskProgressServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UpdateTaskProgressServlet</servlet-name>
        <url-pattern>/update-task-progress</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DeleteAnalysisServlet</servlet-name>
        <servlet-class>com.resumeanalyzer.servlet.DeleteAnalysisServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeleteAnalysisServlet</servlet-name>
        <url-pattern>/delete-analysis</url-pattern>
    </servlet-mapping>
</web-app>
